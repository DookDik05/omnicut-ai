# ─────────────────────────────────────────────────────────────────────────────
# OmniCut AI — Environment Configuration
# Copy this file to `.env.local` and fill in the keys you want to enable.
# Each AI task degrades gracefully to a local mock/deterministic fallback when
# its provider key is missing, so the editor works with zero configuration.
# ─────────────────────────────────────────────────────────────────────────────

# ── Transcription (AI Auto Subtitle) ────────────────────────────────────────
# OpenAI-compatible Whisper endpoint. Leave empty to use the built-in demo
# transcript instead of live transcription.
OPENAI_API_KEY=
# Optional: custom base URL (e.g. a self-hosted OpenAI-compatible gateway).
OPENAI_BASE_URL=https://api.openai.com/v1
# Whisper model to use for transcription.
OPENAI_WHISPER_MODEL=whisper-1

# ── Text-to-Speech (AI Voice Generator) ─────────────────────────────────────
# ElevenLabs Text-to-Speech. Leave empty to estimate voiceovers locally.
ELEVENLABS_API_KEY=
# Optional: override per-voice IDs. Defaults to built-in IDs when empty.
ELEVENLABS_VOICE_ARIA=
ELEVENLABS_VOICE_PREM=
ELEVENLABS_VOICE_KAITO=

# ── Smart Cutout + Audio Enhancer ───────────────────────────────────────────
# Replicate API token for background removal (cutout) and audio denoising
# (enhancer). Leave empty to use local placeholder masks / no-op cleaning.
REPLICATE_API_TOKEN=

# ── B-Roll Suggestion ───────────────────────────────────────────────────────
# B-Roll suggestions are deterministic (transcript-based) and need no key.
# RunComfy key is reserved for future real stock-footage generation.
RUNCOMFY_API_KEY=